#!/bin/sh
set -eu
app_dir=${CYBER_CONSOLE_APP_DIR:-"${XDG_DATA_HOME:-"$HOME/.local/share"}/cyber-console"}
command_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CYBER_CONSOLE_BIN_PATH="$command_dir/cyber-console"
export CYBER_CONSOLE_BIN_PATH
exec python3 "$app_dir/src/cyber_console/cli.py" "$@"
