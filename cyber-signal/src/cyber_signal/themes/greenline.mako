# cyber-signal theme: greenline
# Restrained phosphor-green text on a near-black terminal surface.
# Desktop-wide Mako defaults: ordinary notify-send messages use the selected theme too.
background-color=#07100b
text-color=#b7f7c0
border-color=#63d980
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=8000

[app-name="cyber-signal"]
background-color=#07100b
text-color=#b7f7c0
border-color=#63d980
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=8000

[app-name="cyber-signal" urgency=critical]
background-color=#10180c
text-color=#dcffd7
border-color=#a8f078
border-size=2
