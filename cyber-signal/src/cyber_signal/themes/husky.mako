# cyber-signal theme: husky
# Dark neutral notifications with cool blue borders and a soft green highlight.
background-color=#080808
text-color=#eeeeee
border-color=#cccccc
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=8000

[app-name="cyber-signal"]
background-color=#080808
text-color=#eeeeee
border-color=#cccccc
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=8000

[app-name="cyber-signal" urgency=critical]
background-color=#111111
text-color=#ffffff
border-color=#ffffff
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=0
