#!/bin/sh
# cyber-ware-managed-cli
set -eu

usage() {
    cat <<'EOF'
Usage:
  cyber-ware --theme [synthwave|greenline|husky]
  cyber-ware --uninstall
  cyber-ware --help

Show or switch the shared cyber-ware theme. Theme-aware installed components
are updated, and Hyprland is reloaded when available.
EOF
}

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
theme_file=$config_home/cyber-ware/theme

current_theme() {
    if [ -f "$theme_file" ]; then
        IFS= read -r selected < "$theme_file" || selected=
        case "$selected" in synthwave|greenline|husky) printf '%s\n' "$selected"; return ;; esac
    fi
    printf '%s\n' synthwave
}

uninstall() {
    config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
    state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
    prefix=${PREFIX:-"$HOME/.local"}
    hypr_dir=$config_home/hypr
    module_dir=$hypr_dir/hyprland
    main_config=$hypr_dir/hyprland.lua
    local_config=$hypr_dir/hyprland.local.lua
    state_dir=$state_home/cyber-ware
    install_state=$state_dir/install.state
    command_path=$prefix/bin/cyber-ware

    for path in "$config_home" "$state_home" "$prefix"; do
        case "$path" in /|"") printf '%s\n' 'Refusing an unsafe root-level path.' >&2; return 1 ;; esac
    done
    if [ -L "$install_state" ] || [ ! -f "$install_state" ]; then
        printf '%s\n' 'No valid cyber-ware installation record found; refusing to guess which files to remove.' >&2
        return 1
    fi
    state_version=$(sed -n '1p' "$install_state")
    if [ "$state_version" != 'version=1' ] && [ "$state_version" != 'version=2' ]; then
        printf '%s\n' 'Unsupported cyber-ware installation record; no changes made.' >&2
        return 1
    fi
    command_dir=$(sed -n 's/^command_dir=//p' "$install_state")
    [ -n "$command_dir" ] || command_dir=$prefix/bin
    case "$command_dir" in /|"") printf '%s\n' 'Unsafe command path in install record.' >&2; return 1 ;; esac
    command_path=$command_dir/cyber-ware
    backup_name=$(sed -n 's/^backup_name=//p' "$install_state")
    [ "$backup_name" != none ] || backup_name=
    generated_local_hash=$(sed -n 's/^local_config_sha256=//p' "$install_state")
    created_local=$(sed -n 's/^created_local_config=//p' "$install_state")
    case "$created_local" in yes|no) ;; *) printf '%s\n' 'Invalid installation record; no changes made.' >&2; return 1 ;; esac
    backup_dir=
    if [ -n "$backup_name" ]; then
        case "$backup_name" in .|..|*[!A-Za-z0-9._-]*) printf '%s\n' 'Unsafe backup reference in installation record.' >&2; return 1 ;; esac
        backup_dir=$state_dir/backups/$backup_name
        if [ -L "$backup_dir" ] || [ ! -d "$backup_dir" ]; then
            printf 'Recorded backup is missing or unsafe: %s\n' "$backup_dir" >&2
            return 1
        fi
    fi
    if [ -L "$hypr_dir" ] || [ -L "$main_config" ] || [ -L "$module_dir" ] || [ -L "$local_config" ]; then
        printf '%s\n' 'A Hyprland config target is a symlink; refusing to modify it.' >&2
        return 1
    fi
    if [ -e "$command_path" ] && { [ -L "$command_path" ] || [ ! -f "$command_path" ] || [ "$(sed -n '2p' "$command_path")" != '# cyber-ware-managed-cli' ]; }; then
        printf 'Refusing to remove an unrelated command: %s\n' "$command_path" >&2
        return 1
    fi

    printf '%s\n' 'This restores the Hyprland config backed up before cyber-ware was installed and removes the cyber-ware command.'
    printf '%s\n' 'Optional components, their configuration/data, and the shared theme preference will be left alone.'
    if ! (exec 3</dev/tty) 2>/dev/null; then
        printf '%s\n' 'Run this command from an interactive terminal to confirm the uninstall.' >&2
        return 1
    fi
    printf 'Type cyber-ware to confirm: '
    IFS= read -r answer </dev/tty || answer=
    if [ "$answer" != cyber-ware ]; then
        printf '%s\n' 'Cancelled.'
        return 1
    fi

    recovery_dir=$(mktemp -d "$state_dir/before-uninstall.XXXXXX")
    [ ! -e "$main_config" ] || cp -a -- "$main_config" "$recovery_dir/"
    [ ! -d "$module_dir" ] || cp -a -- "$module_dir" "$recovery_dir/"
    [ ! -e "$local_config" ] || cp -a -- "$local_config" "$recovery_dir/"
    [ ! -e "$theme_file" ] || cp -a -- "$theme_file" "$recovery_dir/shared-theme"

    if [ -n "$backup_dir" ]; then
        rm -rf -- "$module_dir"
        rm -f -- "$main_config"
        [ ! -d "$backup_dir/hyprland" ] || cp -a -- "$backup_dir/hyprland" "$module_dir"
        [ ! -f "$backup_dir/hyprland.lua" ] || cp -a -- "$backup_dir/hyprland.lua" "$main_config"
    else
        rm -f -- "$main_config" "$module_dir/appearance.lua" "$module_dir/windows.lua" \
            "$module_dir/autostart.lua" "$module_dir/keybindings.lua" "$module_dir/session-start.sh"
        rmdir "$module_dir" 2>/dev/null || true
    fi
    if [ "$created_local" = yes ] && [ -f "$local_config" ] && [ "$generated_local_hash" = unknown ]; then
        printf 'Kept the migrated local config because this older install has no content hash: %s\n' "$local_config"
    elif [ "$created_local" = yes ] && [ -f "$local_config" ] && \
        { [ -n "$generated_local_hash" ] && [ "$(sha256sum "$local_config" | cut -d ' ' -f 1)" = "$generated_local_hash" ]; }; then
        rm -f -- "$local_config"
    elif [ "$created_local" = yes ] && [ -e "$local_config" ]; then
        printf 'Kept your edited local override at %s; recovery copy is also in %s.\n' "$local_config" "$recovery_dir"
    fi
    [ ! -e "$command_path" ] || rm -f -- "$command_path"
    rm -f -- "$install_state"
    printf 'cyber-ware config uninstalled. Current files were saved in %s; original backups remain in %s/backups.\n' "$recovery_dir" "$state_dir"
    printf '%s\n' 'Optional cyber-ware components remain installed. Use each component command with --uninstall to remove one.'
}

case "${1:-}" in
    --help|-h)
        [ "$#" -eq 1 ] || { printf '%s\n' 'Use cyber-ware --help by itself.' >&2; exit 2; }
        usage
        exit 0
        ;;
    --theme)
        case "$#" in
            1)
                printf 'Current theme: %s; available: synthwave, greenline, husky\n' "$(current_theme)"
                exit 0
                ;;
            2) theme=$2 ;;
            *) printf '%s\n' 'Use: cyber-ware --theme [synthwave|greenline|husky]' >&2; exit 2 ;;
        esac
        ;;
    --uninstall)
        [ "$#" -eq 1 ] || { printf '%s\n' 'Use cyber-ware --uninstall by itself.' >&2; exit 2; }
        uninstall
        exit $?
        ;;
    *) printf '%s\n' 'Use: cyber-ware --theme [synthwave|greenline|husky]' >&2; exit 2 ;;
esac

case "$theme" in
    synthwave|greenline|husky) ;;
    *) printf 'Unknown theme %s; choose synthwave, greenline, or husky.\n' "$theme" >&2; exit 2 ;;
esac
case "$config_home" in /|"") printf '%s\n' 'Refusing an unsafe configuration directory.' >&2; exit 1 ;; esac
if [ -L "$theme_file" ] || { [ -e "$theme_file" ] && [ ! -f "$theme_file" ]; }; then
    printf 'Refusing to replace an unsafe theme file: %s\n' "$theme_file" >&2
    exit 1
fi

mkdir -p "$(dirname -- "$theme_file")"
temporary=$(mktemp "$theme_file.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
printf '%s\n' "$theme" > "$temporary"
chmod 600 "$temporary"
mv -f -- "$temporary" "$theme_file"
trap - EXIT HUP INT TERM
printf 'Shared theme set to %s.\n' "$theme"

failures=
for component in cyber-wall cyber-signal cyber-panel cyber-jackout cyber-deck cyber-console cyber-scan; do
    configured_bin=$(sed -n '1p' "$config_home/cyber-ware/bin-path" 2>/dev/null || true)
    component_command=${configured_bin:-"${PREFIX:-$HOME/.local}/bin"}/$component
    if [ -x "$component_command" ] || command -v "$component" >/dev/null 2>&1; then
        if { [ -x "$component_command" ] && "$component_command" --theme "$theme"; } || \
           { [ ! -x "$component_command" ] && "$component" --theme "$theme"; }; then
            :
        else
            printf 'Could not update %s; its theme may need attention.\n' "$component" >&2
            failures="$failures $component"
        fi
    else
        printf 'Skipping %s (not installed).\n' "$component"
    fi
done

if command -v hyprctl >/dev/null 2>&1; then
    if hyprctl reload >/dev/null 2>&1; then
        printf '%s\n' 'Reloaded Hyprland; the window and group border palette is updated.'
    else
        printf '%s\n' 'Could not reload Hyprland; run `hyprctl reload` in the active session to apply border colors.' >&2
    fi
else
    printf '%s\n' 'hyprctl is unavailable; run `hyprctl reload` in the active session to apply border colors.' >&2
fi

if [ -n "$failures" ]; then
    printf 'Theme state is saved, but these components failed:%s\n' "$failures" >&2
    exit 1
fi
