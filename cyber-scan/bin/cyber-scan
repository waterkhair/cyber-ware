#!/usr/bin/env bash
set -euo pipefail

resolved_script=$(readlink -f -- "${BASH_SOURCE[0]}")
app_dir=$(cd -- "$(dirname -- "$resolved_script")/.." && pwd)

usage() {
    cat <<'EOF'
Usage: cyber-scan
       cyber-scan --theme [synthwave|greenline|husky]
       cyber-scan --check
       cyber-scan --help
       cyber-scan --uninstall

Select a screen region with slurp, capture it with grim, then open it in swappy.
EOF
}

theme_file=${XDG_CONFIG_HOME:-"$HOME/.config"}/cyber-scan/theme
theme=${CYBER_WARE_THEME:-}
if [[ -z "$theme" && -f "$theme_file" ]]; then
    IFS= read -r theme < "$theme_file" || theme=
fi
if [[ -z "$theme" && -f "${XDG_CONFIG_HOME:-$HOME/.config}/cyber-ware/theme" ]]; then
    IFS= read -r theme < "${XDG_CONFIG_HOME:-$HOME/.config}/cyber-ware/theme" || theme=
fi
theme=${theme:-synthwave}

set_theme() {
    local name=$1 config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"} temporary
    case "$name" in synthwave|greenline|husky) ;; *)
        printf 'Unknown theme %s; choose synthwave, greenline, or husky.\n' "$name" >&2
        return 2
        ;;
    esac
    [[ ! -L "$config_dir" && ! -L "$config_dir/cyber-scan" && ! -L "$theme_file" ]] || {
        printf 'Refusing symlinked cyber-scan theme path: %s\n' "$theme_file" >&2
        return 1
    }
    mkdir -p -- "$config_dir/cyber-scan"
    temporary=$(mktemp "$config_dir/cyber-scan/.theme.XXXXXX")
    printf '%s\n' "$name" > "$temporary"
    mv -f -- "$temporary" "$theme_file"
    printf 'Theme set to %s; it will apply to the next screenshot selection.\n' "$name"
}

theme_colors() {
    case "$theme" in
        greenline) printf '%s\n' '-b' '#080d09cc' '-c' '#65c96dff' '-s' '#a0f29622' '-B' '#101a12ff' ;;
        husky) printf '%s\n' '-b' '#000000cc' '-c' '#ffffffff' '-s' '#ffffff22' '-B' '#111111ff' ;;
        *) printf '%s\n' '-b' '#0b0f14cc' '-c' '#00e5ffff' '-s' '#8b5cff22' '-B' '#131b26ff' ;;
    esac
}

check_requirements() {
    local missing=() command
    for command in bash grim mkdir readlink rm slurp swappy; do
        command -v "$command" >/dev/null 2>&1 || missing+=("$command")
    done
    if ((${#missing[@]})); then
        printf 'Missing required commands: %s\n' "${missing[*]}" >&2
        printf '%s\n' 'Install grim, slurp, and swappy with your distribution package manager.' >&2
        return 1
    fi
    printf '%s\n' 'Required commands are available: grim, slurp, and swappy.'
    if [[ -z ${WAYLAND_DISPLAY:-} || -z ${XDG_RUNTIME_DIR:-} ]]; then
        printf '%s\n' 'No active Wayland session environment detected; run captures from Hyprland.' >&2
        return 1
    fi
}

uninstall() {
    local prefix=${PREFIX:-"${HOME}/.local"}
    local data_home=${XDG_DATA_HOME:-"${HOME}/.local/share"}
    local command_path="$prefix/bin/cyber-scan"
    local installed_app_dir="$data_home/cyber-scan"
    if [[ -L "$installed_app_dir" || ! -f "$installed_app_dir/.cyber-scan-managed" ]]; then
        printf '%s\n' 'Refusing to remove cyber-scan files: installation marker is missing or unsafe.' >&2
        return 1
    fi
    if [[ $(readlink -f -- "$command_path" 2>/dev/null || true) != "$installed_app_dir/bin/cyber-scan" ]]; then
        printf 'Refusing to remove an unexpected command at %s.\n' "$command_path" >&2
        return 1
    fi
    rm -- "$command_path"
    rm -rf -- "$installed_app_dir"
    printf 'Removed cyber-scan from %s.\n' "$installed_app_dir"
    printf '%s\n' 'Hyprland and Swappy configuration were not changed.'
}

case "${1:-}" in
    --theme)
        (($# <= 2)) || { usage >&2; exit 2; }
        if (($# == 1)); then
            printf 'Current theme: %s (available: synthwave, greenline, husky)\n' "$theme"
        else
            set_theme "$2"
        fi
        exit
        ;;
    --help|-h)
        (($# <= 1)) || { usage >&2; exit 2; }
        usage
        exit 0
        ;;
    --check)
        (($# == 1)) || { usage >&2; exit 2; }
        check_requirements
        exit
        ;;
    --uninstall)
        (($# == 1)) || { usage >&2; exit 2; }
        uninstall
        exit
        ;;
    "")
        (($# == 0)) || { usage >&2; exit 2; }
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

check_requirements >/dev/null
mapfile -t slurp_theme_args < <(theme_colors)
if ! geometry=$(slurp "${slurp_theme_args[@]}"); then
    exit 0
fi
[[ -n "$geometry" ]] || exit 0
mkdir -p -- "$HOME/Pictures/Screenshots"
grim -g "$geometry" - | swappy -f -
